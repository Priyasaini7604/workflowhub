# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE — WorkflowHub Backend
# =============================================================================
# Copy this file to `.env` in the backend root (same folder as manage.py)
# and fill in real values for your environment.
#
#   cp .env.example .env
#
# DO NOT commit the actual `.env` file with real secrets. `.env` is already
# listed in .gitignore — keep it that way.
# =============================================================================


# -----------------------------------------------------------------------------
# DJANGO CORE
# -----------------------------------------------------------------------------

# Django secret key — used for cryptographic signing.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# NEVER reuse the same key across environments, and never commit a real key.
SECRET_KEY=change-me-to-a-random-secret-key

# Debug mode — MUST be False in production.
DEBUG=True

# Comma-separated list of hosts/domains this Django app is allowed to serve.
# Dev default: *  |  Production example: api.workflowhub.com,www.workflowhub.com
ALLOWED_HOSTS=*


# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (MySQL)
# -----------------------------------------------------------------------------
DB_NAME=workflowhub_db
DB_USER=root
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306


# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API from the browser.
# Dev default: http://localhost:5173 (Vite)
# Production example: https://workflowhub.com,https://www.workflowhub.com
CORS_ALLOWED_ORIGINS=http://localhost:5173


# -----------------------------------------------------------------------------
# EMAIL / SMTP CONFIGURATION
# -----------------------------------------------------------------------------
# Used for FR-09 notifications (task due/overdue reminders) and account emails.
# For Gmail: use an App Password, not your regular account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-smtp-username@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=WorkflowHub <noreply@workflowhub.com>


# -----------------------------------------------------------------------------
# CELERY / REDIS (background tasks + scheduled reminders)
# -----------------------------------------------------------------------------
# Local dev: Memurai (Windows) or native Redis both work on this URL.
# Production: point to a managed Redis (e.g. Upstash, Redis Cloud).
CELERY_BROKER_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# FRONTEND API BASE URL
# -----------------------------------------------------------------------------
# NOTE: this is read by the FRONTEND (Vite), not this Django backend.
# It belongs in frontend/.env (frontend/.env.example), not this file — listed
# here only so the full picture of required env vars is in one place.
#   VITE_API_BASE_URL=http://localhost:8000/api


# -----------------------------------------------------------------------------
# EXTERNAL INTEGRATION CREDENTIALS (where applicable)
# -----------------------------------------------------------------------------
# None currently required by WorkflowHub. Add entries here if/when a new
# integration (e.g. cloud storage, SMS, payment) is introduced — keep
# placeholder values only, never real keys, in this template file.