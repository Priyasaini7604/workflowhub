# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE — WorkflowHub Frontend
# =============================================================================
# Copy this file to `.env` inside the frontend/ folder and fill real values.
#
#   cp .env.example .env
#
# DO NOT commit the actual `.env` file. It's already listed in .gitignore.
# NOTE: Vite only exposes variables prefixed with VITE_ to the browser.
# =============================================================================

# Base URL of the backend API this frontend talks to.
# Dev default: http://localhost:8000/api
# Production example: https://api.workflowhub.com/api
VITE_API_BASE_URL=http://localhost:8000/api
